 #!/bin/bash                                                                                            
                                                                                                        
 show_usage() {                                                                                         
     echo "Usage:"                                                                                      
     echo "  $0 -l|--list -i|--image <image_file>"                                                      
     echo "  $0 -i|--image <image_file> <partition_number> <mount_point>"                               
     exit 1                                                                                             
 }                                                                                                      
                                                                                                        
 if [[ $# -lt 2 ]]; then                                                                                
     show_usage                                                                                         
 fi                                                                                                     
                                                                                                        
 while [[ $# -gt 0 ]]; do                                                                               
     case "$1" in                                                                                       
         -l|--list)                                                                                     
             LIST=true                                                                                  
             shift                                                                                      
             ;;                                                                                         
         -i|--image)                                                                                    
             IMAGE="$2"                                                                                 
             shift 2                                                                                    
             ;;                                                                                         
         *)                                                                                             
             if [[ -z "$PARTITION" ]]; then                                                             
                 PARTITION="$1"                                                                         
             elif [[ -z "$MOUNT_POINT" ]]; then                                                         
                 MOUNT_POINT="$1"                                                                       
             else                                                                                       
                 show_usage                                                                             
             fi                                                                                         
             shift                                                                                      
             ;;                                                                                         
     esac                                                                                               
 done                                                                                                   
                                                                                                        
 if [[ "$LIST" == true && -n "$IMAGE" ]]; then                                                          
     fdisk -l "$IMAGE"                                                                                  
 elif [[ -n "$IMAGE" && -n "$PARTITION" && -n "$MOUNT_POINT" ]]; then                                   
     OFFSET=$(fdisk -l "$IMAGE" | grep "^$IMAGE$PARTITION" | awk '{print $2 * 512}')                    
     sudo mount -o loop,offset="$OFFSET" "$IMAGE" "$MOUNT_POINT"                                             
 else                                                                                                   
     show_usage                                                                                         
 fi                                                                                                     
